{
  "name": "@raeven-co/sether",
  "version": "0.5.5",
  "description": "Streaming PII redaction for AI applications. The hiding place for sensitive data flowing into LLMs. Secrets pack, SSE-aware streaming, audit events, drop-in middlewares for Express / fetch / OpenAI / Anthropic.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "check:regex": "node scripts/check-regex-safety.mjs",
    "check:ascii": "node scripts/check-ascii-dist.mjs",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run check:regex && npm test && npm run build && npm run check:ascii"
  },
  "keywords": [
    "ai",
    "security",
    "pii",
    "redaction",
    "stream",
    "sse",
    "llm",
    "privacy",
    "gdpr",
    "hipaa",
    "compliance",
    "openai",
    "anthropic",
    "secrets",
    "guardrails",
    "agentic",
    "mcp"
  ],
  "author": "Godfrey Lebo <emorylebo@gmail.com> (Raeven Company LTD)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raeven-co/sether.git"
  },
  "homepage": "https://setherai.vercel.app/#sandbox",
  "bugs": {
    "url": "https://github.com/raeven-co/sether/issues",
    "email": "emorylebo@gmail.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/emorilebo"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.4.1",
    "fast-check": "^3.23.0",
    "prettier": "^3.4.0",
    "safe-regex2": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
